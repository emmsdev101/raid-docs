# Copy to `.env` and fill in real values for local development.

APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ── Database (raw PostgreSQL via asyncpg — no ORM) ────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raid_docs

# ── Redis / Celery ────────────────────────────────────────────────────
# Leave CELERY_ENABLED=false to run document ingestion inline (no Redis).
# Flip to true in production once you have a Celery worker running.
CELERY_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Auth ──────────────────────────────────────────────────────────────
# Local mode (default): the API owns email/password credentials and mints
# HS256 access tokens signed with JWT_SECRET_KEY. Generate a random 32+
# character value for production, e.g.:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-insecure-change-me-in-production-please
JWT_ISSUER=raid-docs
JWT_EXPIRES_MINUTES=10080

# External IdP mode (optional): if CLERK_JWKS_URL is set, incoming tokens
# are verified against that JWKS instead. JWT_ALGORITHM defaults to HS256;
# switch to RS256 (or whatever your IdP signs with) in that case.
# CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
# JWT_ALGORITHM=RS256
# JWT_AUDIENCE=

# ── Storage ───────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── AI ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.1:8b
EMBEDDING_DIM=768
